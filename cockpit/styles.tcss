/* projectAlgo cockpit — Textual stylesheet */

Screen {
    background: $background;
    color: $text-primary;
    layers: base overlay;
}

/* ── Layout ──────────────────────────────────────────────── */

#clock-header {
    height: 1;
    background: $surface;
    color: $primary;
    text-style: bold;
    dock: top;
}

#command-footer {
    height: 1;
    background: $surface;
    color: $text-dim;
    dock: bottom;
}

#top-row {
    height: 12;
}

#panel-account {
    width: 28;
    min-width: 24;
    border: round $border;
    border-title-color: $primary;
    border-title-style: bold;
}

#panel-pulse {
    width: 1fr;
    border: round $border;
    border-title-color: $primary;
    border-title-style: bold;
}

#panel-watchlist {
    height: auto;
    min-height: 10;
    border: round $border;
    border-title-color: $primary;
    border-title-style: bold;
}

#bottom-row {
    height: 1fr;
}

#panel-sectors {
    width: 1fr;
    min-width: 36;
    border: round $border;
    border-title-color: $primary;
    border-title-style: bold;
}

#panel-corr {
    width: 1fr;
    border: round $border;
    border-title-color: $primary;
    border-title-style: bold;
}

/* ── Watchlist panel ─────────────────────────────────────── */

#panel-watchlist {
    height: auto;
    min-height: 10;
    max-height: 20;
}

WatchlistPanel {
    height: 1fr;
    width: 1fr;
}

WatchlistPanel:focus {
    border: none;
}

WatchlistRow {
    height: 1;
}

WatchlistRow.wl-error-row {
    color: $text-dim;
}

WatchlistErrorRow {
    height: 1;
    color: $text-dim;
}

/* ── Market pulse panel ──────────────────────────────────── */

MarketPulsePanel {
    height: 1fr;
    width: 1fr;
}

MarketPulsePanel #mp-status {
    height: 1;
    color: $text-dim;
}

MarketPulsePanel .mp-row {
    height: 1fr;
    width: 1fr;
}

PulseCell {
    border: round $border;
    width: 1fr;
    height: 1fr;
    border-title-color: $primary;
    border-title-style: bold;
}

PulseCell .pc-row {
    height: 1;
    width: 1fr;
}

PulseCell .pc-price {
    width: 1fr;
    text-align: right;
    color: $text-primary;
}

PulseCell .pc-change {
    width: 9;
    text-align: right;
    color: $text-dim;
}

PulseCell .pc-change.pc-up {
    color: $positive;
}

PulseCell .pc-change.pc-down {
    color: $negative;
}

PulseCell .pc-pct {
    width: 1fr;
}

PulseCell .pc-spark {
    width: 11;
    color: $text-dim;
    text-align: right;
}

PulseCell.pc-error {
    color: $text-dim;
}

/* ── PanelFrame ──────────────────────────────────────────── */

PanelFrame {
    border: round $border;
    border-title-color: $primary;
    border-title-style: bold;
    padding: 0 1;
}

/* ── PriceCell / PctCell ─────────────────────────────────── */

PriceCell {
    color: $text-primary;
}

PriceCell.flash-up {
    background: $flash-up-bg;
    color: $flash-text;
}

PriceCell.flash-down {
    background: $flash-down-bg;
    color: $flash-text;
}

PriceCell.directional-up {
    color: $positive;
}

PriceCell.directional-down {
    color: $negative;
}

PctCell {
    color: $text-primary;
}

PctCell.flash-up {
    background: $flash-up-bg;
    color: $flash-text;
}

PctCell.flash-down {
    background: $flash-down-bg;
    color: $flash-text;
}

PctCell.directional-up {
    color: $positive;
}

PctCell.directional-down {
    color: $negative;
}

/* ── Help screen ─────────────────────────────────────────── */

HelpScreen {
    align: center middle;
}

HelpScreen PanelFrame {
    width: 72;
    height: auto;
    border: round $border;
    border-title-color: $primary;
    border-title-style: bold;
    padding: 0 1;
}

HelpScreen Static {
    color: $secondary;
}

HelpScreen CommandFooter {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text-dim;
}

/* ── Sector panel ────────────────────────────────────────── */

SectorPanel {
    width: 1fr;
    height: 1fr;
}

SectorPanel .sp-grid {
    layout: vertical;
    height: 1fr;
}

SectorPanel .sp-row {
    layout: horizontal;
    height: 1fr;
}

SectorCell {
    width: 1fr;
    height: 1fr;
    border: round $border;
    border-title-color: $text-dim;
    border-title-style: bold;
    /* background is set imperatively per-cell by update_cell() */
}

SectorCell .sc-label {
    height: 1;
    color: $text-dim;
}

SectorCell .sc-data {
    height: 1;
}

/* ── Sector deep-dive screen ─────────────────────────────── */

SectorDeepDiveScreen {
    layout: vertical;
}

SectorDeepDiveScreen > #deep-dive-header {
    height: 1;
    color: $primary;
    background: $surface;
    text-style: bold;
    dock: top;
}

SectorDeepDiveScreen > #deep-dive-footer {
    height: 1;
    background: $surface;
    color: $text-dim;
    dock: bottom;
}

SectorTable {
    height: 1fr;
    border: solid $border;
    overflow-y: auto;
    padding: 0 1;
}

/* ── Correlation panel (home) ────────────────────────────── */

CorrelationPanel {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

CorrelationPanel #corr-grid {
    color: $text-primary;
}

/* ── Correlation deep-dive screen ────────────────────────── */

CorrelationDeepDiveScreen {
    layout: vertical;
}

CorrelationDeepDiveScreen > #corr-dd-header {
    height: 1;
    color: $primary;
    background: $surface;
    text-style: bold;
    dock: top;
}

CorrelationDeepDiveScreen > #corr-dd-footer {
    height: 1;
    background: $surface;
    color: $text-dim;
    dock: bottom;
}

#corr-dd-body {
    height: 1fr;
}

CorrelationTable {
    width: 2fr;
    height: 1fr;
    border: solid $border;
    overflow: auto;
    padding: 0 1;
}

RankedPairList {
    width: 1fr;
    height: 1fr;
    border: solid $border;
    overflow-y: auto;
    padding: 0 1;
}

/* ── Account panel placeholder ───────────────────────────── */

#account-content {
    color: $text-dim;
}

/* ── Resize warning (shown via CSS class on Screen) ─────── */

#resize-warning {
    display: none;
    layer: overlay;
    width: 100%;
    height: 100%;
    background: $negative;
    color: $flash-text;
    align: center middle;
    text-style: bold;
}

Screen.too-small #resize-warning {
    display: block;
}
