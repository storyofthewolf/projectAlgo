# Schwab API credentials — copy this file to .env and fill in your values.
# Never commit the .env file (it is listed in .gitignore).
#
# Get APP_KEY and APP_SECRET from the Schwab developer portal:
#   https://developer.schwab.com
#
# SCHWAB_CALLBACK_URL must match exactly what you registered in your app.
# The default below works for local development.

SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_TOKEN_PATH=~/.schwab_token.json
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
